<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_program_form_coupon_validity" model="ir.ui.view">
        <field name="name">loyalty.program.form.coupon.validity</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_from']" position="before">
                <field name="separate_coupon_validity"
                       invisible="program_type != 'next_order_coupons'"/>
                <separator string="Voucher Issuance"
                           invisible="program_type != 'next_order_coupons' or not separate_coupon_validity"/>
                <field name="coupon_issuance_start_date"
                       invisible="program_type != 'next_order_coupons' or not separate_coupon_validity"
                       required="program_type == 'next_order_coupons' and separate_coupon_validity"/>
                <field name="coupon_issuance_end_date"
                       invisible="program_type != 'next_order_coupons' or not separate_coupon_validity"
                       required="program_type == 'next_order_coupons' and separate_coupon_validity"/>
                <separator string="Voucher Redemption (Start Date / End Date below)"
                           invisible="program_type != 'next_order_coupons' or not separate_coupon_validity"/>
            </xpath>
        </field>
    </record>
</odoo>
