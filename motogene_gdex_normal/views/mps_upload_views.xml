<odoo>
 <record id="gdex_mps_upload_wizard_form" model="ir.ui.view">
  <field name="name">motogene.gdex.mps.upload.wizard.form</field>
  <field name="model">motogene.gdex.mps.upload.wizard</field>
  <field name="arch" type="xml">
   <form string="Import Official GDEX MPS Labels">
    <sheet>
     <div class="alert alert-info" role="alert">
      Download the complete parent + child MPS PDF from myGDEX Prime.
      This import checks each page and stores one 100x150 mm label per piece for printing/reprint.
      The GDEX API did not provide child labels in our tests.
     </div>
     <group>
      <field name="consignment_id" invisible="1"/>
      <field name="picking_id" readonly="1"/>
      <field name="awb" readonly="1"/>
      <field name="pieces" readonly="1"/>
      <field name="pdf_file" filename="filename" required="1"/>
      <field name="filename" invisible="1"/>
     </group>
    </sheet>
    <footer>
     <button name="action_import" type="object" string="Verify and Save MPS Labels" class="btn-primary"/>
     <button string="Back" special="cancel" class="btn-secondary"/>
    </footer>
   </form>
  </field>
 </record>
</odoo>
