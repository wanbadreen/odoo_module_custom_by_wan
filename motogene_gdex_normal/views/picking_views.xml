<odoo>
 <record id="gdex_normal_picking_form" model="ir.ui.view">
  <field name="name">stock.picking.gdex.normal.form</field>
  <field name="model">stock.picking</field>
  <field name="inherit_id" ref="stock.view_picking_form"/>
  <field name="arch" type="xml">
   <xpath expr="//header" position="inside">
    <field name="x_studio_order_type" invisible="1"/>
    <field name="mori_awb_no" invisible="1"/>
    <button name="action_open_gdex_actions" type="object" string="GDEX"
            class="btn-secondary" groups="motogene_gdex_normal.group_gdex_normal_user,base.group_system"
            invisible="picking_type_code != 'outgoing' or x_studio_order_type != 'Normal'"/>
   </xpath>
  </field>
 </record>
</odoo>
