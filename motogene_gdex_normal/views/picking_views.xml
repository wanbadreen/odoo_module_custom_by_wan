<odoo>
 <record id="gdex_normal_picking_form" model="ir.ui.view">
  <field name="name">stock.picking.gdex.normal.form</field>
  <field name="model">stock.picking</field>
  <field name="inherit_id" ref="stock.view_picking_form"/>
  <field name="arch" type="xml">
   <xpath expr="//header" position="inside">
    <field name="gdex_order_type" invisible="1"/>
    <field name="gdex_studio_type_available" invisible="1"/>
    <field name="mori_awb_no" invisible="1"/>
    <button name="action_open_gdex_actions" type="object" string="GDEX"
            class="btn-secondary" groups="motogene_gdex_normal.group_gdex_normal_user,base.group_system"
            invisible="picking_type_code != 'outgoing' or gdex_order_type not in ('Normal', 'COD')"/>
   </xpath>
   <xpath expr="//sheet/notebook" position="before">
    <group string="GDEX Shipment Type"
           groups="motogene_gdex_normal.group_gdex_normal_user,base.group_system"
           invisible="gdex_studio_type_available or picking_type_code != 'outgoing'">
      <field name="gdex_order_type_fallback" readonly="state in ('done', 'cancel')"/>
    </group>
   </xpath>
   <xpath expr="//sheet/notebook" position="inside">
    <page name="gdex_cod_awbs" string="GDEX COD Parcels"
          invisible="gdex_order_type != 'COD'">
      <group>
        <field name="gdex_cod_summary" readonly="1"/>
      </group>
      <field name="gdex_cod_ids" readonly="1">
        <list create="false" delete="false">
          <field name="parcel_no"/>
          <field name="awb"/>
          <field name="cod_amount"/>
          <field name="currency_id" column_invisible="True"/>
          <field name="state"/>
          <field name="api_environment"/>
        </list>
      </field>
    </page>
   </xpath>
  </field>
 </record>
</odoo>
