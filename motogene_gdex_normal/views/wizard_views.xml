<odoo>
 <record id="gdex_normal_wizard_form" model="ir.ui.view">
  <field name="name">motogene.gdex.wizard.form</field>
  <field name="model">motogene.gdex.wizard</field>
  <field name="arch" type="xml">
   <form string="GDEX Normal Consignment">
    <sheet>
     <div class="alert alert-info" role="alert">Only Ready, outgoing, Normal Delivery DOs are eligible. An unknown request must be checked in the GDEX Portal before retrying.</div>
     <field name="line_ids" nolabel="1">
      <list editable="bottom" create="false" delete="false">
       <field name="picking_id" readonly="1"/>
       <field name="receiver_name"/>
       <field name="receiver_mobile"/>
       <field name="receiver_address1"/>
       <field name="receiver_postcode"/>
       <field name="weight"/>
       <field name="pieces"/>
       <field name="result" readonly="1" optional="show"/>
      </list>
     </field>
     <field name="results" readonly="1" widget="text"/>
    </sheet>
    <footer>
     <button name="action_create" type="object" string="Create Eligible AWBs" class="btn-primary"/>
     <button name="action_print_results" type="object" string="Bulk Print Successful AWBs"/>
     <button special="cancel" string="Close" class="btn-secondary"/>
    </footer>
   </form>
  </field>
 </record>
 <record id="gdex_normal_bulk_action" model="ir.actions.server">
  <field name="name">Create GDEX Normal Consignment</field>
  <field name="model_id" ref="stock.model_stock_picking"/>
  <field name="binding_model_id" ref="stock.model_stock_picking"/>
  <field name="binding_view_types">list</field>
  <field name="state">code</field>
  <field name="code">action = records.action_gdex_normal_wizard()</field>
  <field name="groups_id" eval="[(4, ref('motogene_gdex_normal.group_gdex_normal_user'))]"/>
 </record>
</odoo>
