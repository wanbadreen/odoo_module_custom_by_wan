<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_motogene_event_daily_config_list" model="ir.ui.view">
        <field name="name">motogene.event.daily.config.list</field>
        <field name="model">motogene.event.daily.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="website_id"/>
                <field name="enabled"/>
                <field name="timezone"/>
            </list>
        </field>
    </record>
    <record id="view_motogene_event_daily_config_form" model="ir.ui.view">
        <field name="name">motogene.event.daily.config.form</field>
        <field name="model">motogene.event.daily.config</field>
        <field name="arch" type="xml">
            <form string="MotoGene Daily Summary Configuration">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="website_id" domain="[('company_id', '=', company_id)]"/>
                            <field name="enabled"/>
                            <field name="timezone"/>
                        </group>
                        <group string="Proposed Daily Send Time">
                            <field name="send_hour"/>
                            <field name="send_minute"/>
                            <label string="Scheduler remains disabled until timing and deployment are approved."/>
                        </group>
                    </group>
                    <group string="Global Staff Recipients">
                        <field name="recipient_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="History">
                            <field name="summary_ids" readonly="1">
                                <list>
                                    <field name="report_date"/>
                                    <field name="state"/>
                                    <field name="event_count"/>
                                    <field name="new_count"/>
                                    <field name="active_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_motogene_event_daily_summary_list" model="ir.ui.view">
        <field name="name">motogene.event.daily.summary.list</field>
        <field name="model">motogene.event.daily.summary</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="report_date"/>
                <field name="config_id"/>
                <field name="state"/>
                <field name="event_count"/>
                <field name="new_count"/>
                <field name="active_count"/>
            </list>
        </field>
    </record>
    <record id="view_motogene_event_daily_summary_form" model="ir.ui.view">
        <field name="name">motogene.event.daily.summary.form</field>
        <field name="model">motogene.event.daily.summary</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="report_date"/>
                        <field name="config_id"/>
                        <field name="state"/>
                        <field name="event_count"/>
                        <field name="new_count"/>
                        <field name="active_count"/>
                        <field name="recipient_snapshot"/>
                        <field name="attachment_id"/>
                        <field name="mail_id"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_motogene_daily_config" model="ir.actions.act_window">
        <field name="name">Daily Summary Configuration</field>
        <field name="res_model">motogene.event.daily.config</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_motogene_daily_history" model="ir.actions.act_window">
        <field name="name">Daily Summary History</field>
        <field name="res_model">motogene.event.daily.summary</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_motogene_daily_root" name="MotoGene Event Reports"
              sequence="95" groups="base.group_system"/>
    <menuitem id="menu_motogene_daily_config" name="Daily Summary Settings"
              parent="menu_motogene_daily_root" action="action_motogene_daily_config" sequence="10"/>
    <menuitem id="menu_motogene_daily_history" name="Daily Summary History"
              parent="menu_motogene_daily_root" action="action_motogene_daily_history" sequence="20"/>
</odoo>
