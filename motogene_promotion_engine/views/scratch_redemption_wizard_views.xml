<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scratch_redemption_wizard" model="ir.ui.view">
        <field name="name">motogene.scratch.redemption.wizard.form</field>
        <field name="model">motogene.scratch.redemption.wizard</field>
        <field name="arch" type="xml">
            <form string="Redeem Scratch Card">
                <group>
                    <field name="sale_id"/>
                    <field name="available_card_ids" invisible="1"/>
                    <field name="card_id" domain="[('id', 'in', available_card_ids)]"
                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    <field name="prize_description"/>
                    <field name="expiry_date"/>
                    <field name="reward_type" invisible="1"/>
                    <field name="mystery_product_id" invisible="reward_type != 'mystery'" required="reward_type == 'mystery'"/>
                    <field name="notes"/>
                </group>
                <group string="Choose Gift Colours / Variants" invisible="not gift_choice_ids">
                    <field name="gift_stock_options" widget="scratch_gift_stock_picker" nolabel="1" colspan="2"/>
                    <field name="gift_variant_count" invisible="1"/>
                    <field name="single_allowed_variant_ids" invisible="1"/>
                    <field name="selected_variant_id"
                           invisible="gift_variant_count != 1"
                           readonly="1" force_save="1"
                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                    <field name="gift_choice_ids" nolabel="1" invisible="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="reward_line_id" column_invisible="1" readonly="1" force_save="1"/>
                            <field name="product_tmpl_id" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="allowed_product_ids" column_invisible="1"/>
                            <field name="product_id" force_save="1"/>
                        </list>
                    </field>
                </group>
                <p>Gifts can be redeemed without a paid purchase. Rebates require a purchase covering the rebate amount. The configured reward will be added automatically.</p>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Redemption" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>




