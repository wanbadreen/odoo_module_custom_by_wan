<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_motogene_promotion_engine" model="ir.ui.view">
        <field name="name">sale.order.form.motogene.promotion.engine</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="scratch_redeem_available" invisible="1"/>
                <button name="action_redeem_scratch_card" type="object" string="Redeem Scratch Card"
                        class="btn-primary" groups="sales_team.group_sale_salesman"
                        invisible="state not in ('draft', 'sent') or not scratch_redeem_available"/>
                <button name="action_recompute_motogene_promotions"
                        type="object"
                        string="Recompute Promotions"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="lucky_draw_program_id" invisible="1"/>
                <field name="lucky_draw_entries" readonly="1"
                       invisible="not lucky_draw_program_id"/>
                <field name="scratch_program_id" invisible="1"/>
                <field name="scratch_base_cards" readonly="1" invisible="not scratch_program_id"/>
                <field name="scratch_vip_cards" readonly="1" invisible="not scratch_program_id"/>
                <field name="scratch_total_cards" readonly="1" invisible="not scratch_program_id"/>
                <field name="scratch_allocation_deferred" invisible="1"/>
                <field name="scratch_pending_cards" readonly="1" invisible="not scratch_allocation_deferred"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Scratch Card Serials" name="motogene_scratch_card_serials"
                      invisible="not scratch_card_line_ids and not scratch_program_id">
                    <div class="alert alert-warning" role="status" invisible="not scratch_allocation_deferred">
                        Cards Pending Allocation: serial numbers were insufficient. Pack only the listed serial numbers. The remaining card entitlement is pending; product delivery may proceed.
                    </div>
                    <field name="scratch_card_line_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="prefix"/>
                            <field name="serial_number"/>
                            <field name="expiry_date"/>
                            <field name="state"/>
                            <field name="picking_id"/>
                            <field name="return_picking_id"/>
                            <field name="returned_at"/>
                            <field name="redemption_id"/>
                        </list>
                    </field>
                </page>
                <page string="Scratch Card Redemptions" invisible="not scratch_redemption_ids"
                      groups="sales_team.group_sale_salesman,stock.group_stock_user">
                    <p class="text-muted">Rewards are added automatically on redemption. Cancelling an undelivered, uninvoiced order reverses redemption; the original card expiry still applies.</p>
                    <field name="scratch_redemption_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="card_id"/>
                            <field name="prize_snapshot"/>
                            <field name="state"/>
                            <field name="redeemed_at"/>
                            <field name="redeemed_by_id"/>
                        </list>
                    </field>
                </page>
                <page string="Promotion Rewards" name="motogene_promotion_rewards">
                    <field name="promotion_reward_line_ids" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="promotion_program_id"/>
                            <field name="product_id"/>
                            <field name="product_uom_qty"/>
                            <field name="price_unit"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
