<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         PROMOTION PROGRAM LIST VIEW
    ========================================================== -->
    <record id="view_motogene_promotion_program_list" model="ir.ui.view">
        <field name="name">motogene.promotion.program.list</field>
        <field name="model">motogene.promotion.program</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="state"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="rule_type"/>
                <field name="reward_product_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>


    <!-- =========================================================
         PROMOTION PROGRAM FORM VIEW
    ========================================================== -->
    <record id="view_motogene_promotion_program_form" model="ir.ui.view">
        <field name="name">motogene.promotion.program.form</field>
        <field name="model">motogene.promotion.program</field>
        <field name="arch" type="xml">

            <form string="Promotion Program">

                <!-- =========================
                     HEADER
                ========================== -->
                <header>

                    <button
                        name="action_activate"
                        type="object"
                        string="Activate"
                        class="btn-primary"
                        invisible="state == 'active'"
                    />

                    <button
                        name="action_set_draft"
                        type="object"
                        string="Set to Draft"
                        invisible="state == 'draft'"
                    />

                    <button
                        name="action_archive_program"
                        type="object"
                        string="Archive"
                        invisible="state == 'archived'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,active,archived"
                    />

                </header>


                <sheet>

                    <!-- =========================
                         TITLE
                    ========================== -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Sep-Oct 2026 Free KoraGene"
                            />
                        </h1>
                    </div>


                    <!-- =========================
                         VALIDITY + CONDITION
                    ========================== -->
                    <group>

                        <group string="Validity">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="priority"/>
                        </group>

                        <group string="Condition">
                            <field name="rule_type"/>
                            <field name="threshold_qty"/>
                            <field name="repeat_reward"/>
                        </group>

                    </group>


                    <!-- =========================
                         SINGLE PRODUCT TAG
                         ELIGIBILITY
                    ========================== -->
                    <group string="Eligibility for Normal Single Products">

                        <group>
                            <field
                                name="eligible_product_tag_ids"
                                widget="many2many_tags"
                                placeholder="e.g. Sep-Oct 2026 Eligible Box"
                            />
                        </group>

                        <group>
                            <field name="tagged_box_units_per_qty"/>
                        </group>

                    </group>

                    <div class="text-muted mb-3">
                        Products carrying any selected Eligible Product Tag
                        will automatically be counted as eligible paid box
                        units. For normal single-box products, keep Tagged
                        Product Paid Box Units at 1.
                    </div>


                    <!-- =========================
                         REWARD
                    ========================== -->
                    <group string="Reward">

                        <group>
                            <field name="reward_type"/>
                            <field name="reward_product_id"/>
                        </group>

                        <group>
                            <field name="reward_qty"/>
                            <field name="reward_line_label"/>
                        </group>

                    </group>


                    <!-- =========================
                         NOTEBOOK
                    ========================== -->
                    <notebook>


                        <!-- =====================
                             ELIGIBLE PACKAGES
                        ====================== -->
                        <page string="Eligible Products / Packages">

                            <p class="text-muted">
                                Use this section for products or packages that
                                represent a specific number of paid boxes.
                                Example: normal box = 1, 2-box combo = 2,
                                3-box combo = 3, and 8-box combo = 8.
                                Explicit Product / Package configuration
                                overrides Product Tag eligibility.
                            </p>

                            <field name="eligibility_line_ids">

                                <list editable="bottom">
                                    <field name="product_tmpl_id"/>
                                    <field name="box_units_per_qty"/>
                                </list>

                            </field>

                        </page>


                        <!-- =====================
                             NOTES
                        ====================== -->
                        <page string="Notes">

                            <field
                                name="notes"
                                placeholder="Internal notes / business rule explanation..."
                            />

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- =========================================================
         ACTION
    ========================================================== -->
    <record id="action_motogene_promotion_program" model="ir.actions.act_window">
        <field name="name">Promotion Programs</field>
        <field name="res_model">motogene.promotion.program</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- =========================================================
         MENU
    ========================================================== -->
    <menuitem
        id="menu_motogene_promotions_root"
        name="Promotions"
        sequence="55"
        web_icon="motogene_promotion_engine,static/description/icon.png"
    />

    <menuitem
        id="menu_motogene_promotion_program"
        name="Promotion Programs"
        parent="menu_motogene_promotions_root"
        action="action_motogene_promotion_program"
        sequence="10"
    />

</odoo>
