<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_motogene_promotion_program_list" model="ir.ui.view">
        <field name="name">motogene.promotion.program.list</field>
        <field name="model">motogene.promotion.program</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="lifecycle_state"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="rule_type"/>
                <field name="reward_product_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_motogene_promotion_program_form" model="ir.ui.view">
        <field name="name">motogene.promotion.program.form</field>
        <field name="model">motogene.promotion.program</field>
        <field name="arch" type="xml">
            <form string="Promotion Program">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_set_draft" type="object" string="Set to Draft" invisible="state == 'draft'"/>
                    <button name="action_archive_program" type="object" string="Archive" invisible="state == 'archived'"/>
                    <field name="state" invisible="1"/>
                    <field name="lifecycle_state" widget="statusbar" statusbar_visible="draft,scheduled,running,ended,archived"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Buy KoraGene Unlock Oshino PWP"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Validity">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   placeholder="All Companies"/>
                            <field name="priority"/>
                        </group>

                        <group string="Condition">
                            <field name="rule_type" readonly="reward_type in ('lucky_draw_entries', 'scratch_cards')"/>

                            <field name="threshold_qty"
                                   invisible="rule_type != 'every_x_qty'"/>

                            <field name="minimum_amount"
                                   invisible="rule_type != 'minimum_purchase'"/>

                            <field name="amount_basis"
                                   invisible="rule_type != 'minimum_purchase'"/>

                            <field name="loyalty_redemption_handling"
                                   invisible="rule_type != 'minimum_purchase'"/>

                            <field name="shipping_handling"
                                   invisible="rule_type != 'minimum_purchase'"/>

                            <field name="repeat_reward"
                                   invisible="rule_type == 'pwp'"/>

                            <field name="pwp_trigger_qty"
                                   invisible="rule_type != 'pwp'"/>

                            <field name="pwp_buy_qty"
                                   invisible="rule_type != 'pwp'"/>

                            <field name="pwp_repeat_per_trigger"
                                   invisible="rule_type != 'pwp'"/>
                        </group>
                    </group>

                    <div class="text-muted mb-3" groups="base.group_multi_company">
                        Leave Company blank to apply this promotion to all companies.
                    </div>

                    <group string="PWP Trigger Eligibility"
                           invisible="rule_type != 'pwp'">
                        <group>
                            <field name="pwp_trigger_product_tmpl_ids"
                                   widget="many2many_tags"
                                   placeholder="e.g. KoraGene Box"/>
                        </group>
                        <group>
                            <field name="pwp_trigger_product_tag_ids"
                                   widget="many2many_tags"
                                   placeholder="Optional trigger product tags"/>
                        </group>
                    </group>

                    <div class="text-muted mb-3" invisible="rule_type != 'pwp'">
                        Trigger products unlock PWP entitlement. The customer or CS must still add the paid
                        PWP Product to the order. Free quantity is capped by both the number of completed
                        trigger entitlements and the number of paid PWP sets selected.
                    </div>

                    <group string="Eligibility for Normal Single Products"
                           invisible="rule_type != 'every_x_qty'">
                        <group>
                            <field name="eligible_product_tag_ids"
                                   widget="many2many_tags"
                                   placeholder="e.g. Sep-Oct 2026 Eligible Box"/>
                        </group>
                        <group>
                            <field name="tagged_box_units_per_qty"/>
                        </group>
                    </group>

                    <div class="text-muted mb-3" invisible="rule_type != 'every_x_qty'">
                        Products carrying any selected Eligible Product Tag will automatically be counted
                        as eligible paid box units. For normal single-box products, keep Tagged Product
                        Paid Box Units at 1.
                    </div>

                    <div class="text-muted mb-3" invisible="rule_type != 'minimum_purchase'">
                        Minimum Purchase Amount rules calculate untaxed eligible spend. Promotion rewards
                        are excluded automatically. You can choose whether normal product discounts,
                        loyalty redemption and shipping affect the eligible amount.
                    </div>

                    <group string="Reward">
                        <group>
                            <field name="reward_type"/>
                            <field name="reward_product_id"
                                   string="PWP Product"
                                   invisible="rule_type != 'pwp'"/>
                            <field name="reward_product_id"
                                   string="Free Product"
                                   invisible="rule_type == 'pwp' or reward_type in ('lucky_draw_entries', 'scratch_cards')"/>
                        </group>
                        <group>
                            <field name="reward_qty"
                                   string="Free Qty per PWP Set"
                                   invisible="rule_type != 'pwp'"/>
                            <field name="reward_qty"
                                   string="Free Quantity Per Reward"
                                   invisible="rule_type == 'pwp' or reward_type in ('lucky_draw_entries', 'scratch_cards')"/>
                            <field name="reward_qty" string="Entries per Threshold"
                                   invisible="reward_type != 'lucky_draw_entries'"/>
                            <field name="reward_qty" string="Cards per Threshold"
                                   invisible="reward_type != 'scratch_cards'" readonly="1"/>
                            <field name="reward_line_label"
                                   invisible="reward_type in ('lucky_draw_entries', 'scratch_cards')"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Eligible Products / Packages"
                              invisible="rule_type != 'every_x_qty' and reward_type != 'scratch_cards'">
                            <p class="text-muted" invisible="reward_type == 'scratch_cards'">
                                Use this section for products or packages that represent a specific number
                                of paid boxes. Example: normal box = 1, 2-box combo = 2, 3-box combo = 3,
                                and 8-box combo = 8. Explicit Product / Package configuration overrides
                                Product Tag eligibility.
                            </p>
                            <field name="eligibility_line_ids" invisible="reward_type == 'scratch_cards'">
                                <list editable="bottom">
                                    <field name="product_tmpl_id"/>
                                    <field name="box_units_per_qty"/>
                                </list>
                            </field>
                            <p class="text-muted" invisible="reward_type != 'scratch_cards'">
                                Select the package products eligible for the VIP bonus. Cards advertised
                                with a package are already counted by the spending rule. Each purchased
                                package unit gives a VIP one additional card.
                            </p>
                            <field name="scratch_package_line_ids" invisible="reward_type != 'scratch_cards'">
                                <list editable="bottom">
                                    <field name="product_tmpl_id"/>
                                    <field name="advertised_cards"/>
                                    <field name="card_prefixes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scratch Card Serial Pools" invisible="reward_type != 'scratch_cards'">
                            <group>
                                <field name="scratch_redemption_expiry_date"/>
                                <field name="scratch_vip_prefix"/>
                                <field name="scratch_extra_prefix" string="Default Extra Spend Card Type"/>
                                <field name="scratch_extra_allowed_prefixes" placeholder="D,B,G"/>
                                <field name="scratch_replacement_policy"/>
                            </group>
                            <p class="text-muted">Set the fixed redemption expiry and the printed serial ranges. Serial numbers are allocated when the Sales Order is confirmed. Open each prefix to configure its reward. Saving a fixed expiry fills legacy cards without a date; existing dates stay unchanged.</p>
                            <field name="scratch_serial_pool_ids">
                                <list>
                                    <field name="prefix"/>
                                    <field name="prize_description"/>
                                    <field name="redemption_reward_type"/>
                                    <field name="first_number"/>
                                    <field name="last_number"/>
                                    <field name="next_number" readonly="1"/>
                                </list>
                                <form string="Card Prefix and Redemption Reward">
                                    <group>
                                        <group string="Serial Range">
                                            <field name="prefix"/>
                                            <field name="first_number"/>
                                            <field name="last_number"/>
                                            <field name="next_number" readonly="1"/>
                                        </group>
                                        <group string="Redemption Reward">
                                            <field name="prize_description"/>
                                            <field name="redemption_reward_type"/>
                                            <field name="rebate_amount" invisible="redemption_reward_type != 'rebate'"/>
                                            <field name="rebate_product_id" invisible="redemption_reward_type != 'rebate'"/>
                                            <field name="mystery_quantity" invisible="redemption_reward_type != 'mystery'"/>
                                        </group>
                                    </group>
                                    <group string="Replacement Rules">
                                        <field name="program_id" invisible="1"/>
                                        <field name="replacement_policy" invisible="1"/>
                                        <field name="allowed_replacement_pool_ids" widget="many2many_tags" domain="[('program_id', '=', program_id), ('prefix', '!=', prefix)]" invisible="replacement_policy != 'allowed'"/>
                                    </group>
                                    <group string="Free Products" invisible="redemption_reward_type != 'products'">
                                        <field name="reward_product_line_ids" nolabel="1">
                                            <list editable="bottom">
                                                <field name="variant_mode"/>
                                                <field name="product_id" invisible="variant_mode == 'choose'" required="variant_mode == 'fixed'" options="{'no_create': True}"/>
                                                <field name="product_tmpl_id" invisible="variant_mode != 'choose'" required="variant_mode == 'choose'" options="{'no_create': True}"/>
                                                <field name="quantity"/>
                                            </list>
                                        </field>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="scratch_replacement_history" readonly="1" invisible="reward_type != 'scratch_cards'"/>
                            <field name="notes" placeholder="Internal notes / business rule explanation..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_motogene_promotion_program" model="ir.actions.act_window">
        <field name="name">Promotion Programs</field>
        <field name="res_model">motogene.promotion.program</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_motogene_promotions_root"
              name="Promotions"
              sequence="55"
              web_icon="motogene_promotion_engine,static/description/icon.png"/>

    <menuitem id="menu_motogene_promotion_program"
              name="Promotion Programs"
              parent="menu_motogene_promotions_root"
              action="action_motogene_promotion_program"
              sequence="10"/>

</odoo>



