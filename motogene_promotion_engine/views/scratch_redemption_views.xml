<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scratch_redemption_list" model="ir.ui.view">
        <field name="name">motogene.scratch.redemption.list</field>
        <field name="model">motogene.scratch.redemption</field>
        <field name="arch" type="xml">
            <list>
                <field name="card_id"/>
                <field name="partner_id"/>
                <field name="target_sale_id"/>
                <field name="expiry_date"/>
                <field name="prize_snapshot"/>
                <field name="state"/>
                <field name="redeemed_at"/>
                <field name="redeemed_by_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_scratch_redemption_form" model="ir.ui.view">
        <field name="name">motogene.scratch.redemption.form</field>
        <field name="model">motogene.scratch.redemption</field>
        <field name="arch" type="xml">
            <form string="Scratch Card Redemption">
                <header>
                    <button name="action_confirm_redemption" type="object" string="Confirm Redemption"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="sales_team.group_sale_salesman"
                            confirm="Confirm that the scratched prize, serial and expiry match this record. This consumes the card permanently. Add the gift or rebate to the quotation manually."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        This records redemption only. CS must manually add the gift or rebate to the redemption quotation. No reward line is added automatically.
                    </div>
                    <group>
                        <group string="Find and Verify Card">
                            <field name="company_id" invisible="1"/>
                            <field name="commercial_partner_id" invisible="1"/>
                            <field name="card_id" readonly="state == 'confirmed'"
                                   placeholder="Search a serial, e.g. D8002"
                                   domain="[('state', '!=', 'released'), ('sale_id.company_id', 'in', context.get('allowed_company_ids', []))]"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="card_state"/>
                            <field name="partner_id"/>
                            <field name="program_id"/>
                            <field name="source_sale_id"/>
                            <field name="source_picking_id"/>
                            <field name="prize_preview" invisible="state == 'confirmed'"/>
                            <field name="prize_snapshot" invisible="state != 'confirmed'"/>
                        </group>
                        <group string="Next Purchase and Card Evidence">
                            <field name="target_sale_id" readonly="state == 'confirmed'"
                                   domain="[('state', 'in', ['draft', 'sent']), ('company_id', '=', company_id), ('partner_id.commercial_partner_id', '=', commercial_partner_id)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="expiry_date" readonly="state == 'confirmed'"/>
                            <field name="photo_filename" invisible="1"/>
                            <field name="card_photo" filename="photo_filename" required="1" readonly="state == 'confirmed'"/>
                            <field name="redeemed_at" invisible="state != 'confirmed'"/>
                            <field name="redeemed_by_id" invisible="state != 'confirmed'"/>
                        </group>
                    </group>
                    <group string="CS Verification Notes">
                        <field name="notes" nolabel="1" readonly="state == 'confirmed'"
                               placeholder="Record the scratched prize and any manual gift or rebate details."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_scratch_redemption_search" model="ir.ui.view">
        <field name="name">motogene.scratch.redemption.search</field>
        <field name="model">motogene.scratch.redemption</field>
        <field name="arch" type="xml">
            <search>
                <field name="card_id"/>
                <field name="partner_id"/>
                <field name="target_sale_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
            </search>
        </field>
    </record>
    <record id="action_scratch_redemption" model="ir.actions.act_window">
        <field name="name">Scratch Card Redemption</field>
        <field name="res_model">motogene.scratch.redemption</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_scratch_redemption_search"/>
    </record>
    <!-- Loaded after the promotion menu through the manifest. -->
    <menuitem id="menu_scratch_redemption" name="Scratch Card Redemption"
              parent="menu_motogene_promotions_root" action="action_scratch_redemption"
              groups="sales_team.group_sale_salesman,stock.group_stock_user" sequence="30"/>
</odoo>
