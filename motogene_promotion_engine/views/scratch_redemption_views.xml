<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scratch_redemption_list" model="ir.ui.view">
        <field name="name">motogene.scratch.redemption.list</field>
        <field name="model">motogene.scratch.redemption</field>
        <field name="arch" type="xml">
            <list>
                <field name="card_id"/>
                <field name="partner_id"/>
                <field name="target_sale_id"/>
                <field name="expiry_date"/>
                <field name="prize_snapshot"/>
                <field name="state"/>
                <field name="redeemed_at"/>
                <field name="redeemed_by_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_scratch_redemption_form" model="ir.ui.view">
        <field name="name">motogene.scratch.redemption.form</field>
        <field name="model">motogene.scratch.redemption</field>
        <field name="arch" type="xml">
            <form string="Scratch Card Redemption">
                <header>
                    <button name="action_confirm_redemption" type="object" string="Confirm Redemption"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="sales_team.group_sale_salesman"
                            confirm="Confirm that the scratched prize and serial match this record. The configured reward will be added to the quotation and the card marked Redeemed."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        Confirming adds the configured reward to the quotation. Cancel an undelivered, uninvoiced Sales Order to reverse redemption.
                    </div>
                    <group>
                        <group string="Find and Verify Card">
                            <field name="company_id" invisible="1"/>
                            <field name="commercial_partner_id" invisible="1"/>
                            <field name="card_id" readonly="state != 'draft'"
                                   placeholder="Search a serial, e.g. D8002"
                                   domain="[('state', '!=', 'released'), ('sale_id.company_id', 'in', context.get('allowed_company_ids', []))]"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="card_state"/>
                            <field name="partner_id"/>
                            <field name="program_id"/>
                            <field name="source_sale_id"/>
                            <field name="source_picking_id"/>
                            <field name="prize_preview" invisible="state == 'confirmed'"/>
                            <field name="prize_snapshot" invisible="state != 'confirmed'"/>
                        </group>
                        <group string="Next Purchase and Card Evidence">
                            <field name="target_sale_id" readonly="state != 'draft'"
                                   domain="[('state', 'in', ['draft', 'sent']), ('company_id', '=', company_id), ('partner_id.commercial_partner_id', '=', commercial_partner_id)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="expiry_date" readonly="1"/>
                            <field name="reward_type" invisible="1"/>
                            <field name="mystery_product_id" invisible="reward_type != 'mystery'" required="reward_type == 'mystery'" readonly="state != 'draft'"/>
                            <field name="photo_filename" invisible="1"/>
                            <field name="card_photo" filename="photo_filename" required="1" readonly="state != 'draft'"/>
                            <field name="redeemed_at" invisible="state != 'confirmed'"/>
                            <field name="redeemed_by_id" invisible="state != 'confirmed'"/>
                        </group>
                    </group>
                    <group string="Customer Gift Colours / Variants">
                        <button name="action_load_gift_choices" type="object" string="Reload Gift Choices" invisible="state != 'draft' or reward_type != 'products'"/>
                        <field name="gift_choice_ids" nolabel="1" readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="reward_line_id" column_invisible="1" readonly="1" force_save="1"/>
                            <field name="product_tmpl_id" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="allowed_product_ids" column_invisible="1"/>
                            <field name="product_id" domain="[('id', 'in', allowed_product_ids)]" required="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        </list>
                    </field>
                    </group>
                    <group string="CS Verification Notes">
                        <field name="notes" nolabel="1" readonly="state != 'draft'"
                               placeholder="Record the scratched prize and any manual gift or rebate details."/>
                    </group>
                </sheet>
                <group string="Cancellation History" invisible="state != 'cancelled'">
                    <field name="cancelled_at"/>
                    <field name="cancelled_by_id"/>
                </group>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_scratch_redemption_search" model="ir.ui.view">
        <field name="name">motogene.scratch.redemption.search</field>
        <field name="model">motogene.scratch.redemption</field>
        <field name="arch" type="xml">
            <search>
                <field name="card_id"/>
                <field name="partner_id"/>
                <field name="target_sale_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>
    <record id="action_scratch_redemption" model="ir.actions.act_window">
        <field name="name">Scratch Card Redemption</field>
        <field name="res_model">motogene.scratch.redemption</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_scratch_redemption_search"/>
    </record>
    <!-- Loaded after the promotion menu through the manifest. -->
    <menuitem id="menu_scratch_redemption" name="Scratch Card Redemption"
              parent="menu_motogene_promotions_root" action="action_scratch_redemption"
              groups="sales_team.group_sale_salesman,stock.group_stock_user" sequence="30"/>
</odoo>

