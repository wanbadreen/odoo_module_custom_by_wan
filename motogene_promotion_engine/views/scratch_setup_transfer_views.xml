<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scratch_setup_transfer" model="ir.ui.view">
        <field name="name">motogene.scratch.setup.transfer.form</field>
        <field name="model">motogene.scratch.setup.transfer</field>
        <field name="arch" type="xml">
            <form string="Transfer Scratch Setup">
                <group>
                    <field name="program_id"/>
                    <field name="mode" invisible="1"/>
                    <field name="filename" invisible="1"/>
                    <field name="file_data" filename="filename" readonly="mode == 'export'" required="mode == 'import'"/>
                </group>
                <p>Transfers packages, fixed expiry, serial ranges and prefix rewards. Products must already exist in the destination database. Card history and used serial counters are not transferred.</p>
                <p invisible="mode != 'import'">Import is allowed only into a Draft promotion with no allocated card history. Review the settings before activation.</p>
                <footer>
                    <button name="action_import" type="object" string="Import Setup" class="btn-primary" invisible="mode != 'import'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_promotion_scratch_setup_transfer" model="ir.ui.view">
        <field name="name">motogene.promotion.program.scratch.setup.transfer</field>
        <field name="model">motogene.promotion.program</field>
        <field name="inherit_id" ref="view_motogene_promotion_program_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_scratch_setup" type="object" string="Export Setup" invisible="reward_type != 'scratch_cards'"/>
                <button name="action_import_scratch_setup" type="object" string="Import Setup" invisible="reward_type != 'scratch_cards' or state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
