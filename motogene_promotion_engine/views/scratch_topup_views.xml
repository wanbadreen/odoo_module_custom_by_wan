<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scratch_topup_wizard" model="ir.ui.view">
        <field name="name">motogene.scratch.topup.wizard.form</field>
        <field name="model">motogene.scratch.topup.wizard</field>
        <field name="arch" type="xml">
            <form string="Scratch &amp; Win Card Allocation">
                <group><field name="sale_id"/><field name="partner_id"/><field name="program_id" invisible="1"/></group>
                <group string="Card Entitlement">
                    <field name="package_quantity"/><field name="extra_quantity"/>
                    <field name="vip_quantity"/><field name="total_quantity"/>
                </group>
                <separator string="Additional Card Selection"/>
                <p>Please allocate the additional cards earned based on spending. Package cards and VIP bonus cards follow the promotion settings. Available Cards shows the balance after package and VIP requirements; availability is checked again on confirmation.</p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="pool_id" options="{'no_open': True, 'no_create': True}"/>
                        <field name="prize_description"/><field name="available_quantity"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <group><field name="selected_quantity"/></group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Allocation &amp; Sales Order" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
