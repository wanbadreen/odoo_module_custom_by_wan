<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_motogene_promotion_program_form_customer_exclusions" model="ir.ui.view">
        <field name="name">motogene.promotion.program.form.customer.exclusions</field>
        <field name="model">motogene.promotion.program</field>
        <field name="inherit_id" ref="motogene_promotion_engine.view_motogene_promotion_program_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="excluded_partner_tag_ids"
                       widget="many2many_tags"
                       placeholder="e.g. Dealer, Staff, Shareholder"/>
            </xpath>
        </field>
    </record>
</odoo>
