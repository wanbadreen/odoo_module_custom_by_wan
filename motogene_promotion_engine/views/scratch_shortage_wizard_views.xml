<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scratch_shortage_wizard" model="ir.ui.view">
        <field name="name">motogene.scratch.shortage.wizard.form</field>
        <field name="model">motogene.scratch.shortage.wizard</field>
        <field name="arch" type="xml">
            <form string="Scratch Card Serial Shortage">
                <field name="order_ids" invisible="1"/>
                <field name="message" nolabel="1" readonly="1"/>
                <p>Proceed to confirm and ship products without allocating cards. The full card entitlement will remain pending and will appear on the SO, DO and Picking Operations printout.</p>
                <footer>
                    <button name="action_proceed_without_cards" type="object" string="Proceed Without Cards" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
