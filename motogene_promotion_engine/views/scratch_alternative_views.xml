<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scratch_alternative_wizard" model="ir.ui.view">
        <field name="name">motogene.scratch.alternative.wizard.form</field>
        <field name="model">motogene.scratch.alternative.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Alternative Cards">
                <field name="order_ids" invisible="1"/>
                <p>Available original cards are kept first. Select replacements for the missing cards only. Use Split to choose more than one replacement type. Stock and the current promotion policy are checked again on confirmation.</p>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sale_id" readonly="1"/>
                        <field name="source_pool_id" readonly="1"/>
                        <field name="missing_quantity" readonly="1"/>
                        <field name="allowed_pool_ids" column_invisible="1"/>
                        <field name="replacement_pool_id" domain="[('id', 'in', allowed_pool_ids)]" options="{'no_create': True, 'no_open': True}"/>
                        <field name="quantity"/>
                        <field name="available_quantity" readonly="1"/>
                        <field name="prize_description" readonly="1"/>
                        <button name="action_split" type="object" string="Split" invisible="quantity &lt;= 1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm With Alternative Cards" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_sale_scratch_replacement_history" model="ir.ui.view">
        <field name="name">sale.order.scratch.replacement.history</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="motogene_promotion_engine.view_order_form_motogene_promotion_engine"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scratch_card_line_ids']/list/field[@name='prefix']" position="after">
                <field name="original_prefix" optional="show"/>
                <field name="replacement_by_id" optional="hide"/>
                <field name="replacement_at" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
