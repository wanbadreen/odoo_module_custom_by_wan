<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="scratch_card_serial_list">
        <div t-if="o.picking_type_code == 'outgoing' and o.scratch_allocation_deferred and o.scratch_pending_cards" class="mt-4" style="border: 2px solid black; padding: 10px;">
            <strong>SCRATCH CARDS PENDING ALLOCATION</strong>
            <p>Pending cards for this Sales Order: <strong t-field="o.scratch_pending_cards"/>. Pack only the serial numbers listed below. Remaining cards are pending; products may be dispatched.</p>
        </div>
        <t t-set="cards_to_pack" t-value="o.scratch_card_line_ids.filtered(lambda c: c.state != 'released')"/>
        <div t-if="o.picking_type_code == 'outgoing' and cards_to_pack"
             class="mt-4" name="motogene_scratch_cards_to_pack">
            <h4>Scratch &amp; Win Cards to Pack</h4>
            <p>Total Cards: <strong t-esc="len(cards_to_pack)"/></p>
            <p>Check these serial numbers against the physical cards before dispatch.</p>
            <table style="width: 60%; border-collapse: collapse; font-size: 17px;">
                <thead>
                    <tr>
                        <th style="border: 1px solid black; padding: 6px;">Card Type</th>
                        <th style="border: 1px solid black; padding: 6px;">Serial Number</th>
                        <th style="border: 1px solid black; padding: 6px;">Redemption Expiry</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="cards_to_pack" t-as="card">
                        <td style="border: 1px solid black; padding: 6px;"><span t-field="card.prefix"/></td>
                        <td style="border: 1px solid black; padding: 6px;"><strong t-field="card.serial_number"/></td>
                        <td style="border: 1px solid black; padding: 6px;"><span t-field="card.expiry_date"/></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>
    <function model="stock.picking" name="configure_scratch_card_picking_report">
        <value eval="'stock.report_picking_copy_4'"/>
    </function>
</odoo>
