<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_scratch_cards"
              inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@class='page']" position="inside">
            <div t-if="o.picking_type_code == 'outgoing' and o.scratch_card_line_ids"
                 class="mt-4" name="motogene_scratch_cards_to_pack">
                <h4>Scratch &amp; Win Cards to Pack</h4>
                <p>Check these serial numbers against the physical cards before dispatch.</p>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Card Type</th>
                            <th>Serial Number</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.scratch_card_line_ids" t-as="card">
                            <td><span t-field="card.prefix"/></td>
                            <td><strong t-field="card.serial_number"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
