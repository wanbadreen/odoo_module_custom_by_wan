<odoo>
    <record id="view_fedex_quote_wizard_form" model="ir.ui.view">
        <field name="name">motogene.fedex.quote.wizard.form</field>
        <field name="model">motogene.fedex.quote.wizard</field>
        <field name="arch" type="xml">
            <form string="FedEx Shipping Quotation">
                <group>
                    <field name="order_id"/>
                    <field name="partner_shipping_id"/>
                    <field name="ship_date"/>
                    <field name="weight_source"/>
                </group>
                <group string="International Customs Data for Rate Estimate">
                    <field name="customs_description"/>
                    <field name="origin_country_id"/>
                    <field name="duties_payer"/>
                </group>
                <field name="package_ids">
                    <list editable="bottom" create="1" delete="1">
                        <field name="weight"/>
                        <field name="length"/>
                        <field name="width"/>
                        <field name="height"/>
                    </list>
                </field>
                <footer>
                    <button name="action_fill_odoo_weight" string="Use Odoo Weights"
                            type="object" class="btn-secondary"/>
                    <button name="action_get_rates" string="Get FedEx Rates"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_sale_order_fedex_quote_form" model="ir.ui.view">
        <field name="name">sale.order.fedex.quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_fedex_quote_wizard"
                        string="Get FedEx Quote" type="object"
                        groups="motogene_fedex_quotation.group_fedex_operator,base.group_system"
                        invisible="state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="FedEx Rates" groups="motogene_fedex_quotation.group_fedex_operator,base.group_system">
                    <field name="fedex_quote_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="create_date"/>
                            <field name="service_name"/>
                            <field name="amount"/>
                            <field name="currency_code"/>
                            <field name="surcharge"/>
                            <field name="ship_date"/>
                            <field name="delivery_date"/>
                            <field name="transit_message"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
