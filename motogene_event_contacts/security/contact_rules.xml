<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_motogene_booking_company" model="ir.rule">
        <field name="name">MotoGene Event Booking: allowed companies</field>
        <field name="model_id" ref="model_motogene_event_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('event.group_event_user'))]"/>
    </record>
    <record id="rule_motogene_review_company" model="ir.rule">
        <field name="name">MotoGene Contact Review: allowed companies</field>
        <field name="model_id" ref="model_motogene_event_contact_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('event.group_event_user'))]"/>
    </record>
</odoo>
