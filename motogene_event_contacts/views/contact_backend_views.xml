<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_motogene_contact_config_list" model="ir.ui.view">
        <field name="name">motogene.event.contact.config.list</field>
        <field name="model">motogene.event.contact.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="website_id"/>
                <field name="enabled"/>
                <field name="review_user_id"/>
            </list>
        </field>
    </record>
    <record id="view_motogene_contact_config_form" model="ir.ui.view">
        <field name="name">motogene.event.contact.config.form</field>
        <field name="model">motogene.event.contact.config</field>
        <field name="arch" type="xml">
            <form string="Event Contacts Integration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="website_id" domain="[('company_id', '=', company_id)]"/>
                        <field name="enabled"/>
                        <field name="review_user_id"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Disabled by default. When enabled, only Events with Enable Attendee Contacts
                        checked use the separate Booking Email and optional attendee email flow.
                        Existing registrations are not processed during installation.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_motogene_contact_config" model="ir.actions.act_window">
        <field name="name">Event Contacts Settings</field>
        <field name="res_model">motogene.event.contact.config</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_motogene_contact_config" name="Event Contacts Integration"
              parent="event.menu_event_configuration" action="action_motogene_contact_config"
              groups="base.group_system" sequence="97"/>

    <record id="view_motogene_contact_review_list" model="ir.ui.view">
        <field name="name">motogene.event.contact.review.list</field>
        <field name="model">motogene.event.contact.review</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'" create="0" delete="0">
                <field name="create_date"/>
                <field name="name" string="Participant"/>
                <field name="email"/>
                <field name="event_id"/>
                <field name="reason"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_motogene_contact_review_search" model="ir.ui.view">
        <field name="name">motogene.event.contact.review.search</field>
        <field name="model">motogene.event.contact.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="event_id"/>
                <filter name="pending" string="Pending Review" domain="[('state','=','pending')]"/>
                <filter name="resolved" string="Resolved" domain="[('state','=','resolved')]"/>
            </search>
        </field>
    </record>
    <record id="view_motogene_contact_review_form" model="ir.ui.view">
        <field name="name">motogene.event.contact.review.form</field>
        <field name="model">motogene.event.contact.review</field>
        <field name="arch" type="xml">
            <form string="Event Contact Review" create="0" delete="0">
                <header>
                    <button name="action_link_existing" type="object" string="Link Existing Contact"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_create_separate" type="object" string="Create Separate Contact"
                            invisible="state != 'pending'"
                            confirm="Create a separate Contact for this participant even if another Contact uses this email?"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,resolved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="event_id" readonly="1"/>
                            <field name="registration_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reason" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="resolved_by_id" readonly="1" invisible="state != 'resolved'"/>
                            <field name="resolved_at" readonly="1" invisible="state != 'resolved'"/>
                        </group>
                    </group>
                    <group string="Candidate Contacts">
                        <field name="candidate_ids" widget="many2many_tags" readonly="1"/>
                        <field name="chosen_partner_id" domain="[('id','in',candidate_ids)]"
                               readonly="state != 'pending'"/>
                        <field name="resolution_note" readonly="state != 'pending'"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="state != 'pending'">
                        Registration is valid and unaffected. Review identity before linking Contacts.
                        Do not overwrite existing VIP tags, address or contact details.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_motogene_contact_reviews" model="ir.actions.act_window">
        <field name="name">Contact Reviews</field>
        <field name="res_model">motogene.event.contact.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_motogene_contact_review_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
    <menuitem id="menu_motogene_contact_reviews" name="Contact Reviews"
              parent="event.event_main_menu" action="action_motogene_contact_reviews"
              groups="event.group_event_user" sequence="55"/>

    <record id="view_motogene_booking_list" model="ir.ui.view">
        <field name="name">motogene.event.booking.list</field>
        <field name="model">motogene.event.booking</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="event_id"/>
                <field name="owner_email"/>
                <field name="participant_count"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_motogene_booking_form" model="ir.ui.view">
        <field name="name">motogene.event.booking.form</field>
        <field name="model">motogene.event.booking</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="owner_email"/>
                        <field name="event_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="website_id"/>
                    </group>
                    <field name="registration_ids">
                        <list>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="state"/>
                            <field name="motogene_attendee_contact_id"/>
                            <field name="motogene_contact_sync_status"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_motogene_event_bookings" model="ir.actions.act_window">
        <field name="name">Event Bookings</field>
        <field name="res_model">motogene.event.booking</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_motogene_event_bookings" name="Event Bookings"
              parent="event.event_main_menu" action="action_motogene_event_bookings"
              groups="event.group_event_user" sequence="54"/>

    <record id="view_motogene_event_contact_form_inherit" model="ir.ui.view">
        <field name="name">event.event.motogene.contact.form</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_motogene_contact_reviews" type="object"
                        class="oe_stat_button" icon="fa-exclamation-triangle">
                    <field name="motogene_pending_review_count" widget="statinfo" string="Contact Reviews"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="motogene_attendee_contacts" string="Attendee Contacts">
                    <group>
                        <field name="motogene_contacts_enabled"/>
                        <field name="motogene_contact_tag_ids" widget="many2many_tags"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        A Booking Email is required once per booking. Participant emails are optional
                        for enabled websites. Contacts are matched by own name and email.
                        Tags indicate registration, not attendance or marketing consent.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_motogene_activity_contact_form_inherit" model="ir.ui.view">
        <field name="name">motogene.event.activity.motogene.contacts.form</field>
        <field name="model">motogene.event.activity</field>
        <field name="inherit_id" ref="motogene_event_activity_hub.view_activity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page name="motogene_activity_contacts" string="Attendee Contacts">
                    <group>
                        <field name="motogene_contacts_enabled"/>
                        <field name="motogene_contact_tag_ids" widget="many2many_tags"/>
                    </group>
                    <button name="action_motogene_contact_reviews" type="object"
                            string="Open Contact Reviews" class="btn-secondary"/>
                    <field name="motogene_pending_review_count" readonly="1"/>
                    <div class="alert alert-info" role="alert">
                        Settings are applied to every child session on Prepare / Sync Sessions.
                        Booking Email is mandatory and individual participant email is optional
                        only when the website Contacts integration is enabled.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_motogene_reg_contacts_inherit" model="ir.ui.view">
        <field name="name">event.registration.motogene.attendee.contact.form</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <group string="MotoGene Event Contacts">
                    <field name="motogene_booking_id" readonly="1"/>
                    <field name="motogene_attendee_contact_id" readonly="1"/>
                    <field name="motogene_contact_sync_status" readonly="1"/>
                    <field name="motogene_contact_sync_error" readonly="1"
                           invisible="motogene_contact_sync_status != 'failed'"/>
                    <button name="action_motogene_retry_contact_sync"
                            type="object" string="Retry Contact Sync"
                            class="btn-secondary" invisible="motogene_contact_sync_status not in ['failed','no_email']"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
