<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_activity_allowed_companies" model="ir.rule">
    <field name="name">MotoGene Activity: allowed companies</field>
    <field name="model_id" ref="model_motogene_event_activity"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('event.group_event_user'))]"/>
  </record>
  <record id="rule_session_allowed_companies" model="ir.rule">
    <field name="name">MotoGene Session: allowed activity companies</field>
    <field name="model_id" ref="model_motogene_event_activity_session"/>
    <field name="domain_force">[('activity_id.company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('event.group_event_user'))]"/>
  </record>
</odoo>
