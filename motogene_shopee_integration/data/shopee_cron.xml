<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="ir_cron_shopee_refresh" model="ir.cron">
    <field name="name">MotoGene Shopee: Refresh Connected Shop Tokens</field>
    <field name="model_id" ref="model_motogene_shopee_shop"/>
    <field name="state">code</field>
    <field name="code">model._cron_refresh_tokens()</field>
    <field name="interval_number">30</field>
    <field name="interval_type">minutes</field>
    <field name="active">False</field>
  </record>
  <record id="ir_cron_shopee_awb_progress" model="ir.cron">
    <field name="name">MotoGene Shopee: Process Pending AWBs</field>
    <field name="model_id" ref="stock.model_stock_picking"/>
    <field name="state">code</field>
    <field name="code">model._cron_motogene_shopee_awb_progress()</field>
    <field name="user_id" ref="base.user_admin"/>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="active">False</field>
  </record>
  <record id="ir_cron_shopee_bulk_dropoff" model="ir.cron">
    <field name="name">MotoGene Shopee: Arrange Queued Bulk Drop-offs (Sandbox)</field>
    <field name="model_id" ref="stock.model_stock_picking"/>
    <field name="state">code</field>
    <field name="code">model._cron_motogene_shopee_bulk_dropoff()</field>
    <field name="user_id" ref="base.user_admin"/>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="active">False</field>
  </record>
  <record id="ir_cron_shopee_auto_order_sync" model="ir.cron">
    <field name="name">MotoGene Shopee: Auto Sync New Orders</field>
    <field name="model_id" ref="model_motogene_shopee_shop"/>
    <field name="state">code</field>
    <field name="code">model._cron_motogene_shopee_auto_sync()</field>
    <field name="user_id" ref="base.user_admin"/>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="active">False</field>
  </record>
</odoo>
