<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_motogene_shopee_bulk_shipment_wizard" model="ir.ui.view">
    <field name="name">motogene.shopee.bulk.shipment.wizard.form</field>
    <field name="model">motogene.shopee.bulk.shipment.wizard</field>
    <field name="arch" type="xml">
      <form string="Prepare Shopee Drop-off (Bulk)">
        <group>
          <field name="picking_count" readonly="1"/>
          <field name="note" nolabel="1" readonly="1"/>
        </group>
        <field name="picking_ids" readonly="1" nolabel="1">
          <list create="0" edit="0" delete="0">
            <field name="name"/>
            <field name="state"/>
            <field name="motogene_shopee_shipment_state"/>
            <field name="motogene_shopee_bulk_state"/>
          </list>
        </field>
        <footer>
          <button string="Queue Eligible Drop-offs" type="object" name="action_queue_dropoff"
                  class="btn-primary" groups="base.group_system"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
