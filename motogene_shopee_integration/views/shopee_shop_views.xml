<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_shopee_shop_list" model="ir.ui.view">
    <field name="name">motogene.shopee.shop.list</field>
    <field name="model">motogene.shopee.shop</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="environment"/>
        <field name="state"/>
        <field name="last_connection_test"/>
      </list>
    </field>
  </record>
  <record id="view_shopee_shop_form" model="ir.ui.view">
    <field name="name">motogene.shopee.shop.form</field>
    <field name="model">motogene.shopee.shop</field>
    <field name="arch" type="xml">
      <form string="Shopee Shop">
        <header>
          <button name="action_connect" type="object" string="Connect Shopee" class="btn-primary"/>
          <button name="action_test_connection" type="object" string="Test Connection"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,connected,reauthorize"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="environment" readonly="state == 'connected'"/>
              <field name="partner_id"/>
              <field name="partner_key" password="True"/>
              <field name="redirect_base_url" placeholder="https://example.dev.odoo.com"/>
            </group>
            <group>
              <field name="shop_id" readonly="1"/>
              <field name="token_expiry" readonly="1"/>
              <field name="last_connection_test" readonly="1"/>
              <field name="active"/>
              <field name="production_fulfillment_enabled" invisible="environment != 'production'"/>
            </group>
          </group>
          <div class="alert alert-warning" role="alert" invisible="environment != 'production'">
            Production requires separate activation for API connection, Sales Order creation,
            and shipment actions. Connecting does not automatically process live orders.
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_shopee_shop" model="ir.actions.act_window">
    <field name="name">Shopee Shops</field>
    <field name="res_model">motogene.shopee.shop</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_shopee_root" name="Shopee Integration" sequence="70"
            web_icon="motogene_shopee_integration,static/description/icon.png"
            groups="base.group_system,motogene_shopee_integration.group_shopee_reviewer"/>
  <menuitem id="menu_shopee_config" name="Shopee Shops" parent="menu_shopee_root"
            action="action_shopee_shop" sequence="10" groups="base.group_system"/>
</odoo>
