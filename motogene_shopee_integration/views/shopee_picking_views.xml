<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_picking_motogene_shopee_awb" model="ir.ui.view">
    <field name="name">stock.picking.motogene.shopee.awb</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <field name="motogene_shopee_is_delivery" invisible="1"/>
        <field name="motogene_shopee_awb_attachment_id" invisible="1"/>
        <field name="motogene_shopee_tracking_number" invisible="1"/>
        <field name="motogene_shopee_awb_needs_sync" invisible="1"/>
        <field name="motogene_shopee_shipment_state" invisible="1"/>
        <field name="motogene_shopee_document_state" invisible="1"/>
        <button name="action_motogene_shopee_prepare" type="object"
                string="Prepare Shopee Shipment" class="btn-primary"
                groups="base.group_system"
                invisible="not motogene_shopee_is_delivery or state == 'cancel' or motogene_shopee_awb_attachment_id or motogene_shopee_shipment_state != 'not_sent'"/>
        <button name="action_motogene_shopee_check_progress" type="object"
                string="Check Shipment Progress" class="btn-secondary"
                groups="base.group_system"
                invisible="not motogene_shopee_is_delivery or state == 'cancel' or motogene_shopee_awb_attachment_id or motogene_shopee_shipment_state == 'not_sent'"/>
        <button name="action_motogene_shopee_print_awb" type="object"
                string="Print Shopee AWB" groups="base.group_system"
                class="btn-secondary"
                invisible="not motogene_shopee_is_delivery or not motogene_shopee_awb_attachment_id"/>
      </xpath>
      <xpath expr="//sheet" position="inside">
        <group string="MotoGene Shopee AWB" groups="base.group_system"
               invisible="not motogene_shopee_is_delivery">
          <field name="motogene_shopee_shipment_state" readonly="1"/>
          <field name="motogene_shopee_bulk_state" readonly="1"/>
          <field name="motogene_shopee_bulk_note" readonly="1"/>
          <field name="motogene_shopee_shipping_method" readonly="1"/>
          <field name="motogene_shopee_document_state" readonly="1"/>
          <field name="motogene_shopee_last_progress_check" readonly="1"/>
          <field name="motogene_shopee_progress_checks" readonly="1"/>
          <field name="motogene_shopee_tracking_number" readonly="1"/>
          <field name="motogene_shopee_awb_attachment_id" readonly="1"/>
          <group string="Advanced / Troubleshooting">
            <button name="action_motogene_shopee_arrange_shipment" type="object" string="Arrange Shipment (Advanced)" groups="base.group_system"
                    invisible="motogene_shopee_shipment_state != 'not_sent'"/>
            <button name="action_motogene_shopee_sync_tracking" type="object" string="Sync Tracking" groups="base.group_system"/>
            <button name="action_motogene_shopee_generate_document" type="object" string="Generate AWB Task" groups="base.group_system"
                    invisible="motogene_shopee_document_state != 'not_created'"/>
            <button name="action_motogene_shopee_check_document" type="object" string="Check AWB Status" groups="base.group_system"/>
            <button name="action_motogene_shopee_retrieve_awb" type="object" string="Retrieve AWB (Advanced)" groups="base.group_system"
                    invisible="motogene_shopee_awb_attachment_id"/>
            <button name="action_motogene_shopee_sync_awb_no" type="object" string="Sync AWB No" groups="base.group_system"
                    invisible="not motogene_shopee_awb_needs_sync"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
