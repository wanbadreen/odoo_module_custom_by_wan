<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_shopee_order_form_create_so" model="ir.ui.view">
    <field name="name">motogene.shopee.order.preview.create.so</field>
    <field name="model">motogene.shopee.import.order</field>
    <field name="inherit_id" ref="motogene_shopee_integration.view_shopee_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
        <header>
          <button name="action_sync_escrow" type="object" string="Sync Estimated Income"/>
          <field name="related_sale_order_id" invisible="1"/>
          <button name="action_view_related_so" type="object"
                  string="View Related SO" class="btn-secondary"
                  invisible="not related_sale_order_id"/>
          <button name="action_open_create_sale_wizard" type="object"
                  string="Create Draft SO"
                  class="btn-primary"
                  invisible="mapping_status != 'matched' or order_status != 'READY_TO_SHIP' or related_sale_order_id"/>
        </header>
      </xpath>
    </field>
  </record>
  <record id="view_shopee_create_sale_wizard_form" model="ir.ui.view">
    <field name="name">motogene.shopee.create.sale.wizard.form</field>
    <field name="model">motogene.shopee.create.sale.wizard</field>
    <field name="arch" type="xml">
      <form string="Create Shopee Test Quotation">
        <group>
          <field name="preview_id"/>
          <field name="partner_id" invisible="1"/>
          <field name="company_id"/>
          <div class="alert alert-info" role="alert">Customer and delivery address are automatically mapped from verified Shopee recipient data.</div>
        </group>
        <div class="alert alert-warning" role="alert">
          This creates a draft quotation only, using prices from the selected Shopee Shop.
          It does not create an invoice, delivery order, shipment, or payment. Production SO creation requires separate approval.
        </div>
        <footer>
          <button name="action_create_draft_so" type="object"
                  string="Create Draft Quotation" class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="view_sale_order_motogene_shopee_preview" model="ir.ui.view">
    <field name="name">sale.order.motogene.shopee.preview</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='client_order_ref']" position="after">
        <field name="motogene_shopee_channel" readonly="1" invisible="not motogene_shopee_channel"/>
        <field name="motogene_shopee_order_ref" readonly="1"
               invisible="not motogene_shopee_order_ref"/>
        <field name="motogene_shopee_preview_id" readonly="1"
               invisible="not motogene_shopee_preview_id"/>
      </xpath>
    </field>
  </record>
</odoo>
